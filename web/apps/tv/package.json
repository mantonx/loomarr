{
  "name": "@loomarr/tv",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "description": "Expo TV client with an isolated prototype identity and explicit permanent-identity Shield release builds.",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "storybook": "EXPO_PUBLIC_LOOMARR_STORYBOOK_DENSITY=tv EXPO_TV=1 STORYBOOK_ENABLED=true expo start",
    "doctor": "EXPO_TV=1 expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:emulator": "../../scripts/test-tv-emulator-journey.sh",
    "references:capture": "../../scripts/capture-tv-native-references.sh",
    "bundle": "EXPO_TV=1 expo export --platform android --output-dir dist/android-tv && EXPO_TV=1 expo export --platform ios --output-dir dist/apple-tv"
  },
  "dependencies": {
    "@loomarr/core": "workspace:*",
    "@loomarr/design-system": "workspace:*",
    "@loomarr/player": "workspace:*",
    "@loomarr/ui": "workspace:*",
    "@loomarr/ui-tv": "workspace:*",
    "@react-native-tvos/config-tv": "0.1.6",
    "expo": "58.0.0-canary-20260812-27f94d4",
    "expo-keep-awake": "58.0.0-canary-20260812-27f94d4",
    "expo-secure-store": "58.0.0-canary-20260812-27f94d4",
    "expo-splash-screen": "58.0.0-canary-20260812-27f94d4",
    "expo-status-bar": "58.0.0-canary-20260812-27f94d4",
    "expo-system-ui": "58.0.0-canary-20260812-27f94d4",
    "expo-video": "58.0.0-canary-20260812-27f94d4",
    "@loomarr/lan-discovery-native": "workspace:*",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.2-0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@loomarr/fixtures": "workspace:*",
    "@types/react": "19.2.18",
    "expo-doctor": "1.20.4",
    "typescript": "7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
