{
  "name": "@loomarr/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Loomarr web app — Vite + React 18 + Tailwind v4 + shadcn (Test Card).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm bundle:check",
    "client-proof": "vite build --config vite.client-platform.config.ts && vitest run --config vite.client-platform.config.ts tests/client-platform-proof.ssr.test.tsx",
    "bundle:check": "node ../../../scripts/check-fe-bundle.mjs",
    "preview": "vite preview",
    "generate:routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@loomarr/api": "workspace:*",
    "@loomarr/core": "workspace:*",
    "@loomarr/design-system": "workspace:*",
    "@loomarr/fixtures": "workspace:*",
    "@loomarr/player": "workspace:*",
    "@loomarr/ui-tv": "workspace:*",
    "@loomarr/tokens": "workspace:*",
    "@loomarr/ui": "workspace:*",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-virtual": "3.14.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.35.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.2",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "thumbhash": "0.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-themes": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/router-cli": "1.167.33",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "http-server": "14.1.1",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  }
}
